# Copie para .env.local. Use a URL e a anon key do projeto Supabase hospedado (Settings > API). Nao ha ambiente local.
VITE_SUPABASE_URL=https://<projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
# Opcional: forca as Edge Functions do Servicos (financeiro/oficina) a executar na mesma
# regiao do banco (hoje us-west-2), evitando round-trip extra por consulta SQL dentro da
# function. Deixe vazio para manter o comportamento padrao (regiao mais proxima de quem chama).
VITE_SERVICOS_FUNCTIONS_REGION=
